# 노션 API 설정 (필수)
# 발급 안내: https://www.notion.so/my-integrations 에서 새 내부 통합 생성
NOTION_API_KEY=your_notion_api_key_here
NOTION_BOOK_DB_ID=your_book_database_id_32chars
NOTION_LOG_DB_ID=your_reading_log_database_id_32chars
NOTION_INSIGHT_DB_ID=your_insight_database_id_32chars
# (선택/신규) 사용자 관리 DB ID
NOTION_USER_DB_ID=your_user_database_id_32chars

# Google Gemini AI API 설정 (AI 독서 감상문 & 이미지 OCR용)
# 발급 안내: https://aistudio.google.com/app/apikey (무료)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# LG EXAONE AI API 설정 (선택: 설정 화면에서 Gemini와 선택 전환 가능)
# 발급 안내: https://docs.exaone.ai (개발·비상업적 테스트 무료)
EXAONE_API_KEY=your_exaone_api_key_here
# EXAONE_MODEL=k-exaone_v2.5
# EXAONE_API_BASE_URL=https://api.exaone.ai/v1
# EXAONE_VISION_MODEL=

# 도서 검색 API 설정 (카카오 추천)
# 발급 안내: https://developers.kakao.com/console/app
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 국립중앙도서관 API (도서 검색 시 쪽수 자동 파싱용)
# 발급 안내: https://www.nl.go.kr/NL/contents/N31101010000.do
NL_API_KEY=your_nl_cert_key_here

# 기타 검색 API (선택사항)
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
ALADIN_API_KEY=your_aladin_ttb_key_here

# 푸터 노션 바로가기 웹 링크 (선택사항)
# 웹앱 하단에 '노션 데이터베이스 열기 ↗' 바로가기 버튼을 표시하고 싶을 때 본인의 공유용 노션 웹 URL을 입력합니다.
# 비워두면 버튼이 화면에 나타나지 않으며, 노션 페이지 주소도 완전히 숨겨집니다.
NEXT_PUBLIC_NOTION_DATABASE_URL=

# [학교별 맞춤형 배포 (White-label Customization)]
# 우리 학교 전용 북튜닝으로 운영하고자 할 때 학교명을 입력합니다. (예: 서울외고)
# 설정 시 웹앱 상단 헤더, 브라우저 탭 타이틀, 입장 화면에 '서울외고 북튜닝'으로 자동 표시됩니다.
# (비워두면 기본 '북튜닝 (Book Tuning)'으로 동작합니다.)
# * Vercel 배포 시 권장 도메인: booktuning-(학교영문약칭).vercel.app (예: booktuning-sfl.vercel.app)
NEXT_PUBLIC_SCHOOL_NAME=


